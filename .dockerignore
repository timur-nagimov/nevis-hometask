# Kept out of every image build: version control, local environments, caches, secrets, and local working
# material no image needs. testset/ and eval/ stay in: the test image copies them for the evaluation.
.git
.github
.venv
.cache
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store
.env
research
dev-plan
