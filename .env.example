# Optional. Copy to .env to change what docker-compose.yml uses; every line shows the default.
# Host port of the API (bound to 127.0.0.1 only)
API_PORT=8000
# Database credentials inside the compose network (the database port is never published). They go into a
# database URL, so use only letters, digits and - . _ ~ (with an @, / or % the API does not start).
POSTGRES_USER=nevis
POSTGRES_PASSWORD=nevis
POSTGRES_DB=nevis
# Settings of the API, read from this file only; docker-compose.yml sets NEVIS_DATABASE_URL, NEVIS_HOST and
# NEVIS_PORT itself. Remove the # to change one.
# NEVIS_LOG_LEVEL=INFO
# NEVIS_MAX_CONTENT_CHARS=50000
# NEVIS_DB_POOL_SIZE=8
# NEVIS_DB_POOL_TIMEOUT_SECONDS=5
# NEVIS_DB_CONNECT_TIMEOUT_SECONDS=3
# NEVIS_DB_STATEMENT_TIMEOUT_MS=5000
