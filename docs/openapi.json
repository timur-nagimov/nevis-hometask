    "/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search clients and documents",
        "description": "Clients and documents matching `q`, best first.\n\nOrder: `score` descending (4 decimals), then `type`, then `id`. `score` >= 0.5: the query words occur in the record or in the document's concept tags (`exact`, `lexical`, `concept`); below 0.5: a typo match (`fuzzy`) or closeness of meaning (`semantic`); below 0.2: a weak guess.",
        "operationId": "search_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
              "description": "Search text. Whitespace runs collapse to one space and the ends are trimmed; then 1-200 characters, no control characters.",
              "title": "Q"
            },
            "description": "Search text. Whitespace runs collapse to one space and the ends are trimmed; then 1-200 characters, no control characters.",
            "examples": {
              "client": {
                "summary": "Client by part of an e-mail domain",
                "value": "NevisWealth"
              },
              "document": {
                "summary": "Document by meaning",
                "value": "address proof"
              }
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "client",
                    "document"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return only this kind of result",
              "title": "Type"
            },
            "description": "Return only this kind of result"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Maximum number of results, clients and documents together",
              "default": 10,
              "title": "Limit"
            },
            "description": "Maximum number of results, clients and documents together"
          }
        ],
        "responses": {
          "200": {
            "description": "Matches, best first; an empty array when nothing matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/ClientSearchItem"
                      },
                      {
                        "$ref": "#/components/schemas/DocumentSearchItem"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "client": "#/components/schemas/ClientSearchItem",
                        "document": "#/components/schemas/DocumentSearchItem"
                      }
                    }
                  },
                  "title": "Response Search Search Get"
                },
                "examples": {
                  "client": {
                    "summary": "q=NevisWealth (illustrative id and score)",
                    "value": [
                      {
                        "type": "client",
                        "score": 0.85,
                        "match_type": "exact",
                        "id": "019aa0c5-6d6e-7c7b-9d55-2f1c3b0a4e11",
                        "first_name": "John",
                        "last_name": "Doe",
                        "email": "john.doe@neviswealth.com",
                        "description": "Founder of a logistics company; prefers ESG funds.",
                        "social_links": [
                          "https://www.linkedin.com/in/johndoe"
                        ]
                      }
                    ]
                  },
                  "document": {
                    "summary": "q=address proof (illustrative id and score)",
                    "value": [
                      {
                        "type": "document",
                        "score": 0.72,
                        "match_type": "concept",
                        "id": "019aa0c6-01a2-7e3f-8a44-9b7d5c2e6f30",
                        "client_id": "019aa0c5-6d6e-7c7b-9d55-2f1c3b0a4e11",
                        "title": "Utility bill",
                        "content": "British Gas utility bill for March 2025. Account holder John Doe, 14 Larkspur Close, Harrogate. Amount due £84.20.",
                        "created_at": "2025-11-20T10:18:42.466123Z",
                        "tags": [
                          "proof of address",
                          "customer due diligence"
                        ],
                        "summary": {
                          "text": "British Gas utility bill for March 2025. Account holder John Doe, 14 Larkspur Close, Harrogate. Amount due £84.20.",
                          "method": "extractive"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "The query string is not valid UTF-8",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "The query string is not valid UTF-8."
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "1 validation error(s).",
                  "errors": [
                    {
                      "loc": [
                        "query",
                        "q"
                      ],
                      "msg": "String should have at least 1 character",
                      "type": "string_too_short"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; no internals are returned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "Unexpected server error."
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable, the service is busy, or a query took too long",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The database is unreachable; retry shortly."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait: always 5",
                "schema": {
                  "type": "integer"
                },
                "example": 5
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Client": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "social_links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Social Links"
          }
        },
        "type": "object",
        "required": [
          "id",
          "first_name",
          "last_name",
          "email",
          "description",
          "social_links"
        ],
        "title": "Client",
        "description": "A client as the API returns it."
      },
      "ClientCreate": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "title": "First Name",
            "description": "Trimmed; 1-100 characters; no control characters"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "title": "Last Name",
            "description": "Trimmed; 1-100 characters; no control characters"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email",
            "description": "Trimmed; at most 254 characters; syntax check only; stored as sent"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f]*$",
            "title": "Description",
            "description": "At most 2,000 characters, verbatim; tab and newline allowed; null or absent: empty",
            "default": ""
          },
          "social_links": {
            "items": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Social Links",
            "description": "At most 20 strings, each trimmed, 1-2,048 characters, not validated as URLs; null: none"
          }
        },
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "email"
        ],
        "title": "ClientCreate",
        "description": "Body of POST /clients. Unknown members are ignored; a client-sent `id` is not honoured.",
        "examples": [
          {
            "description": "Founder of a logistics company, prefers ESG funds",
            "email": "john.doe@neviswealth.com",
            "first_name": "John",
            "last_name": "Doe",
            "social_links": [
              "https://www.linkedin.com/in/johndoe"
            ]
          }
        ]
      },
      "ClientSearchItem": {
        "properties": {
          "type": {
            "type": "string",
            "const": "client",
            "title": "Type",
            "default": "client"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Ordering key, 4 decimals, not a probability. >= 0.5: the query words occur in the record; below 0.5: a typo match"
          },
          "match_type": {
            "type": "string",
            "enum": [
              "exact",
              "fuzzy"
            ],
            "title": "Match Type",
            "description": "`exact`: every query word occurs in name, e-mail or description; `fuzzy`: a typo match"
