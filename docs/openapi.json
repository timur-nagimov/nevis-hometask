{
  "openapi": "3.1.0",
  "info": {
    "title": "Nevis Search API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness check; does not touch the database",
        "description": "`async def` without I/O: answered on the event loop even when every worker thread is busy.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/clients": {
      "post": {
        "tags": [
          "clients"
        ],
        "summary": "Create a client",
        "description": "Creates a new client on every call: e-mail addresses are not unique, and POST is not idempotent.",
        "operationId": "create_client_clients_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Client created",
            "headers": {
              "Location": {
                "description": "URI reference of the new client",
                "schema": {
                  "type": "string",
                  "format": "uri-reference",
                  "example": "/clients/019aa0c5-6d6e-7c7b-9d55-2f1c3b0a4e11"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "400": {
            "description": "Body is not parseable JSON",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "Request body is not valid JSON: Expecting ',' delimiter (character 41)."
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 2,097,152 bytes (rejected before parsing)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Content Too Large"
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "`Content-Type` is not `application/json`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unsupported Media Type",
                  "status": 415,
                  "detail": "Send the body as application/json."
                }
              }
            }
          },
          "422": {
            "description": "A field or parameter failed validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "1 validation error(s).",
                  "errors": [
                    {
                      "loc": [
                        "body"
                      ],
                      "msg": "Field required",
                      "type": "missing"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; no internals are returned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "Unexpected server error."
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable, the service is busy, or a query took too long",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait: always 5",
                "schema": {
                  "type": "integer"
                },
                "example": 5
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The database is unreachable; retry shortly."
                }
              }
            }
          }
        }
      }
    },
    "/clients/{client_id}": {
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "Get a client",
        "description": "A client by id. An id that is not a UUID is answered like an unknown one: 404.",
        "operationId": "get_client_clients__client_id__get",
