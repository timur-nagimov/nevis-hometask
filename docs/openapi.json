            "type": "string",
            "title": "Text"
          },
          "method": {
            "type": "string",
            "const": "extractive",
            "title": "Method"
          }
        },
        "type": "object",
        "required": [
          "text",
          "method"
        ],
        "title": "Summary"
      },
      "Problem": {
        "description": "`type` is always `about:blank`: the HTTP status code carries the meaning.",
        "properties": {
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "HTTP status phrase",
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "status": {
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Human-readable explanation of this occurrence",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Extension member, present on 422 only",
            "title": "Errors"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "FieldError": {
        "description": "One failed field of a 422 response. The submitted value is never echoed.",
        "properties": {
          "loc": {
            "description": "Where: `body`/`query`/`path`, then the field path",
            "examples": [
              [
                "body",
                "email"
              ]
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "examples": [
              "value is not a valid email address: An email address must have an @-sign."
            ],
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "Stable machine-readable error code",
            "examples": [
              "value_error"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      }
    }
