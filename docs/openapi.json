              }
            }
          },
          "404": {
            "description": "Client does not exist (unknown or malformed id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "Client '123' does not exist."
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; no internals are returned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "Unexpected server error."
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable, the service is busy, or a query took too long",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The database is unreachable; retry shortly."
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait: always 5",
                "schema": {
                  "type": "integer"
                },
                "example": 5
              }
            }
          }
        }
      }
    },
