        "type": "object",
        "required": [
          "id",
          "client_id",
          "title",
          "content",
          "created_at",
          "tags",
          "summary"
        ],
        "title": "Document",
        "description": "A document as the API returns it."
      },
      "DocumentCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "title": "Title",
            "description": "Trimmed; 1-300 characters; no control characters"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f]*$",
            "title": "Content",
            "description": "Stored as sent; 1 to NEVIS_MAX_CONTENT_CHARS (default 50,000) characters; not blank; control characters other than tab, line feed and carriage return are rejected"
          }
        },
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "DocumentCreate",
        "description": "Body of POST /clients/{client_id}/documents. Unknown members are ignored.",
        "examples": [
          {
            "content": "British Gas utility bill for March 2025. Account holder John Doe, 14 Larkspur Close, Harrogate. Amount due £84.20.",
            "title": "Utility bill"
          }
        ]
      },
      "DocumentSearchItem": {
        "properties": {
          "type": {
            "type": "string",
            "const": "document",
            "title": "Type",
            "default": "document"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Ordering key, 4 decimals, not a probability. >= 0.5: the query words occur in the title, the text or the concept tags; below 0.5: a typo match or closeness of meaning"
          },
          "match_type": {
            "type": "string",
            "enum": [
              "lexical",
              "concept",
              "fuzzy",
              "semantic"
            ],
            "title": "Match Type",
            "description": "`lexical`: the words are in title or text; `concept`: only with the concept tags; `fuzzy`: a typo of the title or of a concept phrase; `semantic`: closeness of meaning"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
