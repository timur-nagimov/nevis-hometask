          "score",
          "match_type",
          "id",
          "client_id",
          "title",
          "content",
          "created_at",
          "tags",
          "summary"
        ],
        "title": "DocumentSearchItem",
        "description": "A Document plus search metadata, flat: `item['title']` works."
